map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://${EXTAUTH_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Empty values make nginx omit the header entirely: this both
        # strips any client-supplied identity header (no spoofing hop)
        # and — while all EXTAUTH_* values are empty — leaves BookLore on
        # its normal login page (plain reverse proxy mode).
        proxy_set_header ${EXTAUTH_HEADER_USER} "${EXTAUTH_USER}";
        proxy_set_header ${EXTAUTH_HEADER_NAME} "${EXTAUTH_NAME}";
        proxy_set_header ${EXTAUTH_HEADER_EMAIL} "${EXTAUTH_EMAIL}";
        proxy_set_header ${EXTAUTH_HEADER_GROUPS} "${EXTAUTH_GROUPS}";
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        client_max_body_size 0;
    }
}
