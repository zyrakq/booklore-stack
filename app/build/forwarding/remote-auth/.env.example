# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, forwarding/.env.example, remote-auth/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=booklore

# Docker image
IMAGE=ghcr.io/booklore-app/booklore:latest
MARIADB_IMAGE=lscr.io/linuxserver/mariadb:11.4.8

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# File ownership of the managed volumes (must match the volume owner)
USER_ID=1000
GROUP_ID=1000

# Database credentials (DATABASE_USERNAME must exist in MariaDB; both
# DATABASE_PASSWORD and MYSQL_ROOT_PASSWORD are required — leave empty
# and fill before first start)
DATABASE_NAME=booklore
DATABASE_USERNAME=booklore
DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=

SWAGGER_ENABLED=false
FORCE_DISABLE_OIDC=false

TZ=UTC
# Forwarding
BOOKLORE_PORT=6060
# remote-auth (forward-auth)
# BookLore fully trusts the identity headers listed below while
# REMOTE_AUTH_ENABLED=true — never expose booklore:6060 directly; always
# route through booklore-remoteauth-proxy (:6061) or the collection's
# authenticated vhost plumbing.
# Header names are shared by the app and the bundled nginx proxy.
REMOTE_AUTH_ENABLED=true
REMOTE_AUTH_CREATE_NEW_USERS=true
# Header names MUST be all-lowercase: BookLore's latest image (Spring
# Framework 7) resolves the header map case-sensitively against the
# lowercased config value — mixed-case names 400 with "header is missing".
REMOTE_AUTH_HEADER_USER=remote-user
REMOTE_AUTH_HEADER_NAME=remote-name
REMOTE_AUTH_HEADER_EMAIL=remote-email
REMOTE_AUTH_HEADER_GROUPS=remote-groups
# Group that automatically gets admin rights (upstream default: admin).
REMOTE_AUTH_ADMIN_GROUP=admin
# Identity injected by the bundled proxy — any empty value = that header
# is not sent (client-supplied copies are still stripped) and BookLore
# shows its normal login page.
EXTAUTH_USER=
EXTAUTH_NAME=
EXTAUTH_EMAIL=
EXTAUTH_GROUPS=
# Host port of the bundled proxy (upstream booklore stays on :6060).
BOOKLORE_REMOTEAUTH_PORT=6061