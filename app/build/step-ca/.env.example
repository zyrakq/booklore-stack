# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example, oidc/.env.example, step-ca-trust/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=booklore

# Docker image
IMAGE=ghcr.io/booklore-app/booklore:latest
MARIADB_IMAGE=lscr.io/linuxserver/mariadb:11.4.8

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# File ownership of the managed volumes (must match the volume owner)
USER_ID=1000
GROUP_ID=1000

# Database credentials (DATABASE_USERNAME must exist in MariaDB; both
# DATABASE_PASSWORD and MYSQL_ROOT_PASSWORD are required — leave empty
# and fill before first start)
DATABASE_NAME=booklore
DATABASE_USERNAME=booklore
DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=

SWAGGER_ENABLED=false
FORCE_DISABLE_OIDC=false

TZ=UTC
# === STEP CA CONFIGURATION ===
VIRTUAL_PORT=6060
VIRTUAL_HOST=booklore.af
LETSENCRYPT_HOST=booklore.af
LETSENCRYPT_EMAIL=john.smith@mail.com
# OIDC
## Provider (issuer URI / client ID / client secret) is entered in the app's
## settings UI and stored in the database — no env vars for it.
## Web callback: <origin>/oauth2-callback (computed by the UI as
## ${window.location.origin}/oauth2-callback). Kanidm issuer convention:
## https://kanidm.af/oauth2/openid/booklore
## Disable all OIDC flows at startup (provider stays configured).
FORCE_DISABLE_OIDC=false
# Step CA Trust
## Trust the step-ca root CA inside the container for outbound TLS (OIDC
## discovery / token exchange against kanidm.af). The companion handles
## CA installation and the optional container restart.
STEP_CA_TRUST=true
STEP_CA_TRUST_RESTART=true