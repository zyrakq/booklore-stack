# s3fs-fuse
# RustFS endpoint reachable from the booklore container (step-ca-network).
S3FS_ENDPOINT=http://rustfs:9000
# Bucket holding the ebook library (created via mc on the live RustFS).
S3FS_BOOKS_BUCKET=booklore-books
# Bucket holding the bookdrop folder (created via mc on the live RustFS).
S3FS_BOOKDROP_BUCKET=booklore-bookdrop
# S3 credentials (from the stack .env RUSTFS_ACCESS_KEY/RUSTFS_SECRET_KEY) — required.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
